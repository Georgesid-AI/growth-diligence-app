# Copy to backend/.env and fill in. Never commit the filled-in file.

MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=growth_diligence
CORS_ORIGINS=*

# LLM gateway. The gateway is the only component that calls a model provider,
# and this is the only place its key is read from. Never expose it to the
# frontend (no REACT_APP_* variable) and never hardcode a default in code.
ANTHROPIC_API_KEY=

# Model that writes the narratives. Must be in the gateway's price table
# (claude-sonnet-5-5, claude-opus-5-5, ...). Defaults to claude-sonnet-5-5 when unset.
NARRATIVE_MODEL=claude-sonnet-5-5

# Daily ceiling across all runs, in USD. Defaults to 5.00 when unset.
LLM_DAILY_SPEND_CAP_USD=5.00
# Access links (docs/specs/access-links.md): the SHA-256 hex of the owner token (echo -n "$TOKEN" | sha256sum). Without it no
# owner can issue tester links, and every request without a tester token is refused. PUBLIC_APP_URL is the origin printed in links.
OWNER_TOKEN_SHA256=
PUBLIC_APP_URL=
# ACCESS_DISABLED=1 switches the check off (local development and the test suite only; never set it on a deployment).
